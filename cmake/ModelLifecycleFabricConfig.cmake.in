@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

# Model Lifecycle Fabric has no third-party runtime dependencies: it requires a
# C++20 toolchain and the C++ standard library only.
set(ModelLifecycleFabric_VERSION "@PROJECT_VERSION@")
set(ModelLifecycleFabric_PROTOCOL_VERSION "1")

include("${CMAKE_CURRENT_LIST_DIR}/ModelLifecycleFabricTargets.cmake")

check_required_components(ModelLifecycleFabric)
